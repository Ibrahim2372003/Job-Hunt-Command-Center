diff -ruN a/frontend/src/components/ReportPanel.jsx b/frontend/src/components/ReportPanel.jsx
--- a/frontend/src/components/ReportPanel.jsx	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/src/components/ReportPanel.jsx	2026-10-24 02:30:46.472505784 +0000
@@ -0,0 +1,227 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { apiFetch, apiFetchBlob, saveBlob } from "../api.js";
+import { interpretReportStatusResponse, interpretReportRequestResponse, nextActionBeforeRetry, pollReportStatus, reportFilename } from "../lib/reports.js";
+import { createSingleFlight } from "../lib/singleFlight.js";
+
+// phase: checking | none | requesting | pending | done | failed | timeout
+export default function ReportPanel({ application, token, onUnauthorized }) {
+  const [phase, setPhase] = useState("checking");
+  const [message, setMessage] = useState(null); // user-safe text for failed / error states
+  const [downloading, setDownloading] = useState(false);
+  const [downloadError, setDownloadError] = useState(null);
+
+  const controllerRef = useRef(null);
+  const cancelledRef = useRef(false);
+  // Each guard is released in a `finally`, so an unexpected exception can never
+  // leave a button permanently dead.
+  const [pollFlight] = useState(createSingleFlight);
+  const [requestFlight] = useState(createSingleFlight);
+  const [downloadFlight] = useState(createSingleFlight);
+
+  const basePath = `/applications/${application.id}/report`;
+
+  const fetchStatus = useCallback(
+    async () => interpretReportStatusResponse(await apiFetch(basePath, { token, signal: controllerRef.current?.signal })),
+    [basePath, token]
+  );
+
+  const applyResult = useCallback(
+    (result) => {
+      if (cancelledRef.current) return;
+      switch (result.kind) {
+        case "unauthorized":
+          onUnauthorized();
+          break;
+        case "done":
+          setMessage(null);
+          setPhase("done");
+          break;
+        case "failed":
+          setMessage(result.message);
+          setPhase("failed");
+          break;
+        case "timeout":
+          setMessage(null);
+          setPhase("timeout");
+          break;
+        case "none":
+          setPhase("none");
+          break;
+        case "pending":
+          setPhase("pending");
+          break;
+        case "error":
+          setMessage(result.message);
+          setPhase("timeout"); // status unknown: offer a manual re-check, never claim done/failed
+          break;
+        default:
+          break; // cancelled / aborted: the component is going away, show nothing
+      }
+    },
+    [onUnauthorized]
+  );
+
+  // Polling is bounded (see lib/reports.js) and deliberately keeps running
+  // while the AI tools are collapsed: the job runs server-side regardless, and
+  // the user finds the result when they reopen. It stops on unmount.
+  const startPolling = useCallback(async () => {
+    await pollFlight.run(async () => {
+      setPhase("pending");
+      setMessage(null);
+      let result;
+      try {
+        result = await pollReportStatus({ fetchStatus, isCancelled: () => cancelledRef.current });
+      } catch {
+        result = { kind: "error", message: "Could not check the report status." };
+      }
+      applyResult(result);
+    });
+  }, [pollFlight, fetchStatus, applyResult]);
+
+  // One status check on first mount, so an existing or in-progress report is
+  // shown (and polling resumed) after a page reload. `active` is per effect
+  // run, so React StrictMode's mount/unmount/mount cannot let the first run's
+  // aborted request act on the second run's state.
+  useEffect(() => {
+    let active = true;
+    cancelledRef.current = false;
+    controllerRef.current = new AbortController();
+    (async () => {
+      let result;
+      try {
+        result = await fetchStatus();
+      } catch {
+        result = { kind: "error", message: "Could not check the report status." };
+      }
+      if (!active) return;
+      if (result.kind === "pending") startPolling();
+      else applyResult(result);
+    })();
+    return () => {
+      active = false;
+      cancelledRef.current = true; // stops the poll loop and pending state updates
+      controllerRef.current?.abort();
+    };
+    // Intentionally mount-only: fetchStatus/startPolling are stable for a given application+token.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  async function handleRequest() {
+    if (requestFlight.running || pollFlight.running) return;
+    const phaseBefore = phase;
+    await requestFlight.run(async () => {
+      setPhase("requesting");
+      setMessage(null);
+      setDownloadError(null);
+      try {
+        if (phaseBefore === "failed") {
+          // A FAILED report may be mid-retry on the server; look before enqueueing another job.
+          const current = await fetchStatus();
+          if (cancelledRef.current) return;
+          const action = nextActionBeforeRetry(current);
+          if (action.type === "poll") {
+            startPolling(); // owns its own error handling; not awaited so this guard is released
+            return;
+          }
+          if (action.type === "apply") return applyResult(current);
+        }
+
+        const response = await apiFetch(basePath, { method: "POST", token, signal: controllerRef.current?.signal });
+        if (cancelledRef.current || response.aborted) return;
+        const result = interpretReportRequestResponse(response);
+
+        if (result.kind === "pending") {
+          startPolling();
+          return;
+        }
+        if (result.kind === "done") return applyResult(result);
+        if (result.kind === "unauthorized") return onUnauthorized();
+        // needs_tailoring / error: nothing was enqueued; return to a state where the user can act
+        setMessage(result.message);
+        setPhase(phaseBefore === "failed" ? "failed" : "none");
+      } catch {
+        if (cancelledRef.current) return;
+        setMessage("Could not request the report. Please try again.");
+        setPhase(phaseBefore === "failed" ? "failed" : "none");
+      }
+    });
+  }
+
+  async function handleDownload() {
+    await downloadFlight.run(async () => {
+      setDownloading(true);
+      setDownloadError(null);
+      try {
+        const res = await apiFetchBlob(`${basePath}/file`, { token, signal: controllerRef.current?.signal });
+        if (cancelledRef.current || res.aborted) return;
+        if (res.status === 401) return onUnauthorized();
+        if (!res.ok) {
+          setDownloadError(res.data?.message || "Could not download the report.");
+          return;
+        }
+        saveBlob(res.blob, reportFilename(application));
+      } catch {
+        if (!cancelledRef.current) setDownloadError("Could not save the report. Please try again.");
+      } finally {
+        if (!cancelledRef.current) setDownloading(false);
+      }
+    });
+  }
+
+  const busy = phase === "checking" || phase === "requesting" || phase === "pending";
+
+  return (
+    <section className="ai-panel" aria-labelledby={`report-title-${application.id}`}>
+      <h4 id={`report-title-${application.id}`}>PDF report</h4>
+      <p className="field-hint">The PDF is built from your most recent successful tailoring, so tailor your bullets first.</p>
+
+      <div className="report-status" role="status" aria-live="polite">
+        {phase === "checking" && <span>Checking report status...</span>}
+        {phase === "none" && <span>No report has been generated yet.</span>}
+        {phase === "requesting" && <span>Requesting report...</span>}
+        {phase === "pending" && <span>Generating your report. This usually takes a few seconds; this page checks automatically.</span>}
+        {phase === "done" && <span>Your report is ready.</span>}
+        {phase === "failed" && <span>The report could not be generated.</span>}
+        {phase === "timeout" && <span>We could not confirm the report status. It may still be processing.</span>}
+      </div>
+
+      {message && (phase === "failed" || phase === "none" || phase === "timeout") && (
+        <p className="error-list report-message" role="alert">
+          {message}
+        </p>
+      )}
+
+      <div className="form-actions">
+        {(phase === "none" || phase === "failed") && (
+          <button type="button" className="btn btn-primary btn-sm" onClick={handleRequest}>
+            {phase === "failed" ? "Try again" : "Generate PDF report"}
+          </button>
+        )}
+        {phase === "timeout" && (
+          <button type="button" className="btn btn-secondary btn-sm" onClick={startPolling}>
+            Check again
+          </button>
+        )}
+        {phase === "done" && (
+          <button type="button" className="btn btn-primary btn-sm" onClick={handleDownload} disabled={downloading}>
+            {downloading ? "Downloading..." : "Download PDF"}
+          </button>
+        )}
+        {busy && phase !== "checking" && (
+          <button type="button" className="btn btn-secondary btn-sm" disabled>
+            Please wait...
+          </button>
+        )}
+      </div>
+
+      {phase === "done" && (
+        <p className="field-hint">A finished report is not regenerated. If you tailor again, this PDF still contains the earlier version.</p>
+      )}
+      {downloadError && (
+        <p className="error-list report-message" role="alert">
+          {downloadError}
+        </p>
+      )}
+    </section>
+  );
+}
diff -ruN a/frontend/src/components/TailorPanel.jsx b/frontend/src/components/TailorPanel.jsx
--- a/frontend/src/components/TailorPanel.jsx	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/src/components/TailorPanel.jsx	2026-10-24 02:30:46.472184515 +0000
@@ -0,0 +1,185 @@
+import { useEffect, useRef, useState } from "react";
+import { apiFetch } from "../api.js";
+import { validateBulletInput, interpretTailorResponse, formatCostUsd, TAILOR_TIMEOUT_MS, MAX_BULLETS, MAX_BULLET_LENGTH } from "../lib/tailoring.js";
+import { createSingleFlight } from "../lib/singleFlight.js";
+
+const ISSUE_LABEL = { new_number: "a number", new_term: "a tool or term" };
+
+function GroundingNote({ grounding }) {
+  if (!grounding) {
+    return <p className="tailor-note">No fact-check details were returned for this bullet, so review it yourself.</p>;
+  }
+  if (grounding.status === "accepted") {
+    return <p className="tailor-note tailor-note-ok">Fact check passed: no new numbers or tool names were added. This does not check other claims.</p>;
+  }
+  return (
+    <div className="tailor-note tailor-note-warn">
+      <p>
+        <strong>Reverted to your original wording.</strong> The rewrite added details that are not in your bullet:
+      </p>
+      <ul>
+        {grounding.issues.map((issue) => (
+          <li key={`${issue.type}-${issue.value}`}>
+            {ISSUE_LABEL[issue.type]}: <code>{issue.value}</code>
+            {issue.inJobDescription ? " (appears in the job description, not in your bullet)" : ""}
+          </li>
+        ))}
+      </ul>
+      {grounding.rejectedText && (
+        <p className="tailor-rejected">
+          Rejected rewrite: <span>{grounding.rejectedText}</span>
+        </p>
+      )}
+    </div>
+  );
+}
+
+function Usage({ usage }) {
+  if (!usage) return null;
+  const cost = formatCostUsd(usage.costUsd);
+  const rows = [
+    ["Model", usage.model],
+    ["Input tokens", usage.promptTokens],
+    ["Output tokens", usage.completionTokens],
+    ["Estimated cost", cost],
+  ].filter(([, v]) => v !== null && v !== undefined);
+  if (rows.length === 0) return null;
+  return (
+    <dl className="usage-list" aria-label="Usage for this request">
+      {rows.map(([label, value]) => (
+        <div key={label}>
+          <dt>{label}</dt>
+          <dd>{String(value)}</dd>
+        </div>
+      ))}
+    </dl>
+  );
+}
+
+export default function TailorPanel({ application, token, onUnauthorized }) {
+  const [text, setText] = useState("");
+  const [submitting, setSubmitting] = useState(false);
+  const [errors, setErrors] = useState([]);
+  const [result, setResult] = useState(null); // { bullets, grounding, usage, originals }
+  const [flight] = useState(createSingleFlight); // blocks a second submit in the same tick, and always unlocks
+  const mountedRef = useRef(true);
+  const controllerRef = useRef(null);
+
+  // If the card goes away mid-request (application deleted, logout), cancel
+  // the request and never touch state afterwards.
+  useEffect(() => {
+    mountedRef.current = true;
+    controllerRef.current = new AbortController();
+    return () => {
+      mountedRef.current = false;
+      controllerRef.current?.abort();
+    };
+  }, []);
+
+  const inputId = `tailor-input-${application.id}`;
+  const hintId = `tailor-hint-${application.id}`;
+  const errorId = `tailor-errors-${application.id}`;
+
+  async function handleSubmit(event) {
+    event.preventDefault();
+    if (flight.running) return;
+
+    const check = validateBulletInput(text);
+    if (!check.valid) {
+      setErrors(check.errors);
+      return;
+    }
+
+    await flight.run(async () => {
+      setSubmitting(true);
+      setErrors([]);
+      try {
+        const response = await apiFetch(`/applications/${application.id}/tailor`, {
+          method: "POST",
+          body: { baseBullets: check.bullets },
+          token,
+          signal: controllerRef.current?.signal,
+          timeoutMs: TAILOR_TIMEOUT_MS,
+        });
+        if (!mountedRef.current) return;
+
+        const outcome = interpretTailorResponse(response);
+        if (outcome.kind === "unauthorized") return onUnauthorized();
+        if (outcome.kind === "error") {
+          setErrors(outcome.messages); // keep the user's input and any earlier result untouched
+          return;
+        }
+        if (outcome.kind === "success") {
+          setResult({ bullets: outcome.bullets, grounding: outcome.grounding, usage: outcome.usage, originals: check.bullets });
+        }
+        // outcome.kind === "aborted": the panel was torn down; nothing to show
+      } catch {
+        if (mountedRef.current) setErrors(["Something went wrong while tailoring. Please try again."]);
+      } finally {
+        if (mountedRef.current) setSubmitting(false);
+      }
+    });
+  }
+
+  return (
+    <section className="ai-panel" aria-labelledby={`tailor-title-${application.id}`}>
+      <h4 id={`tailor-title-${application.id}`}>Tailor resume bullets</h4>
+      <form onSubmit={handleSubmit} noValidate>
+        <div className="field">
+          <label htmlFor={inputId}>Your current resume bullets</label>
+          <textarea
+            id={inputId}
+            rows={6}
+            value={text}
+            onChange={(e) => setText(e.target.value)}
+            aria-describedby={`${hintId}${errors.length ? ` ${errorId}` : ""}`}
+            aria-invalid={errors.length > 0}
+            disabled={submitting}
+            placeholder={"Built REST APIs in Node.js for a payments platform.\nMentored two junior developers."}
+          />
+          <span id={hintId} className="field-hint">
+            One bullet per line, up to {MAX_BULLETS} bullets of {MAX_BULLET_LENGTH} characters. Only use facts that are true: the AI should not add details, and anything it adds is checked and reverted.
+          </span>
+        </div>
+        <div className="form-actions">
+          <button type="submit" className="btn btn-primary btn-sm" disabled={submitting}>
+            {submitting ? "Tailoring..." : "Tailor to this job"}
+          </button>
+        </div>
+        {submitting && (
+          <p className="state-message-inline" role="status">
+            Tailoring your bullets. This can take a few seconds.
+          </p>
+        )}
+        {errors.length > 0 && (
+          <ul id={errorId} className="error-list" role="alert">
+            {errors.map((e) => (
+              <li key={e}>{e}</li>
+            ))}
+          </ul>
+        )}
+      </form>
+
+      {result && (
+        <div className="tailor-result" aria-live="polite">
+          <h5>Tailored bullets</h5>
+          <p className="field-hint">Review every bullet before using it. The fact check only looks for added numbers and tool names.</p>
+          <ol className="tailor-list">
+            {result.bullets.map((bullet, i) => (
+              <li key={i}>
+                <p className="tailor-bullet">{bullet}</p>
+                {result.grounding?.[i]?.status === "reverted_to_original" ? null : result.originals[i] !== bullet && (
+                  <p className="tailor-original">
+                    Your original: <span>{result.originals[i]}</span>
+                  </p>
+                )}
+                <GroundingNote grounding={result.grounding ? result.grounding[i] : null} />
+              </li>
+            ))}
+          </ol>
+          <Usage usage={result.usage} />
+        </div>
+      )}
+    </section>
+  );
+}
