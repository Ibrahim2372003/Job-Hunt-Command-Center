// M3: authentication added.
// User owns Application via a required userId — every application
// belongs to exactly one user from here on. (M2 had no User model at
// all; see git history / the M2 milestone notes for that version.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         String
  role            String
  jobUrl          String?
  jobDescription  String
  status          Status           @default(SAVED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tailoredResumes TailoredResume[]
  report          Report?
}

enum Status {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

// M4: LLM integration. One row per tailoring call — the cost log the
// concept requires. No ResumeBullet model: base bullets are passed in
// the request, not stored, to keep this milestone as thin as M2/M3
// were.
model TailoredResume {
  id                String      @id @default(uuid())
  applicationId     String
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  bullets           Json
  model             String
  promptTokens      Int
  completionTokens  Int
  costUsd           Decimal
  createdAt         DateTime    @default(now())
}

// Feature 4: async PDF report generation via a background job (same
// pending -> event -> background-function -> status pattern as the
// pdf-report-generator/background-job projects this reuses). One
// Report per Application — @unique below — so "is a report already
// pending/done for this application" is a single indexed lookup, not
// a "most recent of many" query, and duplicate-job prevention falls
// out of the DB constraint rather than app-level locking.
model Report {
  id            String       @id @default(uuid())
  applicationId String       @unique
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ReportStatus @default(PENDING)
  filePath      String?
  error         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum ReportStatus {
  PENDING
  DONE
  FAILED
}
