diff -ruN a/frontend/src/lib/reports.js Job-Hunt-Command-Center-main/frontend/src/lib/reports.js
--- a/frontend/src/lib/reports.js	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/src/lib/reports.js	2026-10-24 02:15:52.116005188 +0000
@@ -0,0 +1,87 @@
+// Bounded polling: first checks come quickly, then settle at 5s. 40 attempts
+// is roughly three minutes in total; after that we stop and let the user
+// re-check manually rather than polling forever.
+export const POLL_DELAYS_MS = [1500, 2000, 3000, 4000, 5000];
+export const MAX_POLL_ATTEMPTS = 40;
+export const MAX_CONSECUTIVE_ERRORS = 3;
+
+const FAILED_FALLBACK = "Report generation failed. You can try again.";
+
+function safeMessage(data, fallback) {
+  return typeof data?.message === "string" && data.message ? data.message : fallback;
+}
+
+/**
+ * Interprets GET /applications/:id/report.
+ * kinds: pending | done | failed | none | unauthorized | aborted | error
+ * "done" is returned ONLY when the server says status === "done".
+ */
+export function interpretReportStatusResponse({ ok, status, data, aborted }) {
+  if (aborted) return { kind: "aborted" };
+  if (status === 401) return { kind: "unauthorized" };
+  if (status === 404 && data?.error === "not_found" && /No report has been requested/i.test(data?.message ?? "")) return { kind: "none" };
+  if (ok && data?.status === "pending") return { kind: "pending" };
+  if (ok && data?.status === "done") return { kind: "done" };
+  if (ok && data?.status === "failed") return { kind: "failed", message: typeof data.error === "string" && data.error ? data.error : FAILED_FALLBACK };
+  return { kind: "error", transient: status === 0 || status >= 500, message: safeMessage(data, "Could not check the report status.") };
+}
+
+/**
+ * Interprets POST /applications/:id/report: 202 pending, 200 done
+ * (already generated), 400 no_tailored_resume, 404, 5xx.
+ */
+export function interpretReportRequestResponse({ ok, status, data, aborted }) {
+  if (aborted) return { kind: "aborted" };
+  if (status === 401) return { kind: "unauthorized" };
+  if (status === 202 && data?.status === "pending") return { kind: "pending" };
+  if (status === 200 && data?.status === "done") return { kind: "done" };
+  if (status === 400 && data?.error === "no_tailored_resume") return { kind: "needs_tailoring", message: safeMessage(data, "Tailor a resume first, then request a report.") };
+  return { kind: "error", message: safeMessage(data, "Could not request the report.") };
+}
+
+const defaultSleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+/**
+ * Sequential poll loop — each check starts only after the previous one
+ * settled, so requests never overlap. Stops on: done, failed, unauthorized,
+ * a non-transient error, too many consecutive transient errors, the attempt
+ * cap ("timeout"), or cancellation. `fetchStatus` must return the result of
+ * interpretReportStatusResponse.
+ */
+export async function pollReportStatus({
+  fetchStatus,
+  isCancelled = () => false,
+  sleep = defaultSleep,
+  delaysMs = POLL_DELAYS_MS,
+  maxAttempts = MAX_POLL_ATTEMPTS,
+  maxConsecutiveErrors = MAX_CONSECUTIVE_ERRORS,
+}) {
+  let consecutiveErrors = 0;
+  for (let attempt = 0; attempt < maxAttempts; attempt++) {
+    if (isCancelled()) return { kind: "cancelled" };
+    await sleep(delaysMs[Math.min(attempt, delaysMs.length - 1)]);
+    if (isCancelled()) return { kind: "cancelled" };
+
+    const result = await fetchStatus();
+    if (isCancelled() || result.kind === "aborted") return { kind: "cancelled" };
+
+    if (result.kind === "pending") {
+      consecutiveErrors = 0;
+      continue;
+    }
+    if (result.kind === "error" && result.transient) {
+      consecutiveErrors += 1;
+      if (consecutiveErrors >= maxConsecutiveErrors) return { kind: "error", message: result.message };
+      continue;
+    }
+    if (result.kind === "none") return { kind: "error", message: "The report request could not be found. Please request it again." };
+    return result; // done | failed | unauthorized | non-transient error
+  }
+  return { kind: "timeout" };
+}
+
+export function reportFilename(application) {
+  const slug = (s) => String(s ?? "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 40);
+  const parts = [slug(application?.company), slug(application?.role)].filter(Boolean);
+  return `${parts.length ? parts.join("-") : "application"}-report.pdf`;
+}
diff -ruN a/frontend/src/lib/tailoring.js Job-Hunt-Command-Center-main/frontend/src/lib/tailoring.js
--- a/frontend/src/lib/tailoring.js	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/src/lib/tailoring.js	2026-10-24 02:15:52.114977720 +0000
@@ -0,0 +1,88 @@
+// Mirrors backend/src/validation.js validateTailorInput. The server stays the
+// source of truth (it re-validates everything); these limits exist so the user
+// gets instant feedback instead of a round trip. Keep in sync if they change.
+export const MAX_BULLETS = 20;
+export const MAX_BULLET_LENGTH = 500;
+
+const LEADING_MARKER = /^\s*(?:[-*\u2022\u2013\u2014]|\d{1,2}[.)])\s+/;
+
+/** One bullet per line; strips common list markers; drops blank lines. */
+export function parseBulletLines(text) {
+  return String(text ?? "")
+    .split(/\r?\n/)
+    .map((line) => line.replace(LEADING_MARKER, "").trim())
+    .filter((line) => line.length > 0);
+}
+
+/** Returns { valid: true, bullets } or { valid: false, errors: string[] }. */
+export function validateBulletInput(text) {
+  const bullets = parseBulletLines(text);
+  const errors = [];
+  if (bullets.length === 0) errors.push("Enter at least one resume bullet.");
+  if (bullets.length > MAX_BULLETS) errors.push(`Enter at most ${MAX_BULLETS} bullets (you entered ${bullets.length}).`);
+  const tooLong = bullets.map((b, i) => ({ i: i + 1, len: b.length })).filter((x) => x.len > MAX_BULLET_LENGTH);
+  for (const { i, len } of tooLong) errors.push(`Bullet ${i} is ${len} characters; the limit is ${MAX_BULLET_LENGTH}.`);
+  return errors.length ? { valid: false, errors } : { valid: true, bullets };
+}
+
+const GROUNDING_STATUSES = ["accepted", "reverted_to_original"];
+
+/**
+ * Accepts the backend's `grounding` array only if every entry has the
+ * expected shape; otherwise returns null so the UI says "not provided"
+ * instead of inventing or half-rendering a verdict.
+ */
+export function normalizeGrounding(grounding, expectedLength) {
+  if (!Array.isArray(grounding) || grounding.length !== expectedLength) return null;
+  const out = [];
+  for (let i = 0; i < grounding.length; i++) {
+    const g = grounding[i];
+    if (!g || typeof g !== "object" || !GROUNDING_STATUSES.includes(g.status)) return null;
+    const issues = Array.isArray(g.issues) ? g.issues : [];
+    out.push({
+      status: g.status,
+      issues: issues
+        .filter((x) => x && typeof x.value === "string" && (x.type === "new_number" || x.type === "new_term"))
+        .map((x) => ({ type: x.type, value: x.value, inJobDescription: x.inJobDescription === true })),
+      rejectedText: typeof g.rejectedText === "string" ? g.rejectedText : null,
+    });
+  }
+  return out;
+}
+
+function normalizeUsage(usage) {
+  if (!usage || typeof usage !== "object") return null;
+  const cost = Number(usage.costUsd);
+  return {
+    model: typeof usage.model === "string" ? usage.model : null,
+    promptTokens: Number.isFinite(usage.promptTokens) ? usage.promptTokens : null,
+    completionTokens: Number.isFinite(usage.completionTokens) ? usage.completionTokens : null,
+    costUsd: Number.isFinite(cost) ? cost : null,
+  };
+}
+
+export function formatCostUsd(value) {
+  return Number.isFinite(value) ? `$${value.toFixed(6)}` : null;
+}
+
+/**
+ * Turns an apiFetch result for POST /applications/:id/tailor into
+ * { kind: "success" | "unauthorized" | "aborted" | "error", ... }.
+ * Only ever surfaces backend messages (already user-safe), never raw bodies.
+ */
+export function interpretTailorResponse({ ok, status, data, aborted }) {
+  if (aborted) return { kind: "aborted" };
+  if (status === 401) return { kind: "unauthorized" };
+  if (ok && status === 201) {
+    const bullets = data?.bullets;
+    if (!Array.isArray(bullets) || bullets.length === 0 || !bullets.every((b) => typeof b === "string")) {
+      return { kind: "error", messages: ["The server returned an unexpected response. Please try again."] };
+    }
+    return { kind: "success", bullets, grounding: normalizeGrounding(data.grounding, bullets.length), usage: normalizeUsage(data.usage) };
+  }
+  if (Array.isArray(data?.messages) && data.messages.every((m) => typeof m === "string") && data.messages.length) {
+    return { kind: "error", messages: data.messages };
+  }
+  if (typeof data?.message === "string" && data.message) return { kind: "error", messages: [data.message] };
+  return { kind: "error", messages: ["Something went wrong while tailoring. Please try again."] };
+}
diff -ruN a/frontend/test/api.test.js Job-Hunt-Command-Center-main/frontend/test/api.test.js
--- a/frontend/test/api.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/test/api.test.js	2026-10-24 02:16:45.571105235 +0000
@@ -0,0 +1,88 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { apiFetch, apiFetchBlob } from "../src/api.js";
+
+function withFetch(impl, fn) {
+  return async () => {
+    const original = globalThis.fetch;
+    const calls = [];
+    globalThis.fetch = async (url, init) => { calls.push({ url, init }); return impl(url, init); };
+    try { await fn(calls); } finally { globalThis.fetch = original; }
+  };
+}
+
+const jsonRes = (status, body, headers = {}) => new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json", ...headers } });
+
+test("apiFetch: sends bearer token and JSON body; defaults to localhost:5000", withFetch(async () => jsonRes(201, { ok: 1 }), async (calls) => {
+  const r = await apiFetch("/applications/1/tailor", { method: "POST", body: { baseBullets: ["a"] }, token: "tok" });
+  assert.deepEqual(r, { ok: true, status: 201, data: { ok: 1 } });
+  assert.equal(calls[0].url, "http://localhost:5000/applications/1/tailor");
+  assert.equal(calls[0].init.headers.Authorization, "Bearer tok");
+  assert.equal(calls[0].init.headers["Content-Type"], "application/json");
+  assert.equal(calls[0].init.body, JSON.stringify({ baseBullets: ["a"] }));
+}));
+
+test("apiFetch: network failure returns a normalized error instead of throwing", withFetch(async () => { throw new TypeError("Failed to fetch"); }, async () => {
+  const r = await apiFetch("/x");
+  assert.equal(r.ok, false);
+  assert.equal(r.status, 0);
+  assert.equal(r.data.error, "network_error");
+}));
+
+test("apiFetch: non-JSON body (e.g. an HTML 502 from a proxy) is normalized, not thrown", withFetch(async () => new Response("<html>Bad gateway</html>", { status: 502, headers: { "content-type": "text/html" } }), async () => {
+  const r = await apiFetch("/x");
+  assert.equal(r.ok, false);
+  assert.equal(r.status, 502);
+  assert.equal(r.data.error, "invalid_response");
+  assert.ok(!JSON.stringify(r).includes("Bad gateway"));
+}));
+
+test("apiFetch: abort is reported as aborted, and the signal is passed through", withFetch(async (_u, init) => {
+  const err = new Error("aborted"); err.name = "AbortError";
+  if (init.signal?.aborted) throw err;
+  return jsonRes(200, {});
+}, async (calls) => {
+  const ctrl = new AbortController(); ctrl.abort();
+  const r = await apiFetch("/x", { signal: ctrl.signal });
+  assert.equal(r.aborted, true);
+  assert.equal(calls[0].init.signal, ctrl.signal);
+}));
+
+test("apiFetchBlob: returns a Blob for a PDF and sends the bearer token", withFetch(async () => new Response("%PDF-1.4 fake", { status: 200, headers: { "content-type": "application/pdf" } }), async (calls) => {
+  const r = await apiFetchBlob("/applications/1/report/file", { token: "tok" });
+  assert.equal(r.ok, true);
+  assert.ok(r.blob instanceof Blob);
+  assert.equal(await r.blob.text(), "%PDF-1.4 fake");
+  assert.equal(calls[0].init.headers.Authorization, "Bearer tok");
+  assert.equal(calls[0].init.headers["Content-Type"], undefined);
+}));
+
+test("apiFetchBlob: 409 not_ready JSON error is surfaced as a failure with the server's message", withFetch(async () => jsonRes(409, { error: "not_ready", message: "The report is not ready yet." }), async () => {
+  const r = await apiFetchBlob("/f");
+  assert.equal(r.ok, false);
+  assert.equal(r.status, 409);
+  assert.equal(r.data.message, "The report is not ready yet.");
+}));
+
+test("apiFetchBlob: 401 keeps its status so the caller can log out", withFetch(async () => jsonRes(401, { error: "unauthorized", message: "Invalid or expired token." }), async () => {
+  assert.equal((await apiFetchBlob("/f")).status, 401);
+}));
+
+test("apiFetchBlob: a 200 that is not a PDF is a failure (never a wrong file)", withFetch(async () => new Response("<html></html>", { status: 200, headers: { "content-type": "text/html" } }), async () => {
+  const r = await apiFetchBlob("/f");
+  assert.equal(r.ok, false);
+  assert.equal(r.data.error, "invalid_response");
+}));
+
+test("apiFetchBlob: non-JSON error body and network failure both normalize", async () => {
+  const original = globalThis.fetch;
+  try {
+    globalThis.fetch = async () => new Response("oops", { status: 500, headers: { "content-type": "text/plain" } });
+    const a = await apiFetchBlob("/f");
+    assert.equal(a.ok, false);
+    assert.equal(a.status, 500);
+    assert.equal(a.data.error, "request_failed");
+    globalThis.fetch = async () => { throw new TypeError("Failed to fetch"); };
+    assert.equal((await apiFetchBlob("/f")).data.error, "network_error");
+  } finally { globalThis.fetch = original; }
+});
diff -ruN a/frontend/test/reports.test.js Job-Hunt-Command-Center-main/frontend/test/reports.test.js
--- a/frontend/test/reports.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/test/reports.test.js	2026-10-24 02:16:45.569824494 +0000
@@ -0,0 +1,122 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { interpretReportStatusResponse, interpretReportRequestResponse, pollReportStatus, reportFilename, MAX_POLL_ATTEMPTS } from "../src/lib/reports.js";
+
+test("status: only a server-confirmed 'done' is done", () => {
+  assert.equal(interpretReportStatusResponse({ ok: true, status: 200, data: { status: "done", reportId: "r", url: "/x" } }).kind, "done");
+  assert.equal(interpretReportStatusResponse({ ok: true, status: 200, data: { status: "pending" } }).kind, "pending");
+  // Anything else — unknown status, wrong shape — must NOT read as done.
+  for (const data of [{ status: "ready" }, { status: "DONE" }, {}, null, { url: "/x" }]) {
+    assert.notEqual(interpretReportStatusResponse({ ok: true, status: 200, data }).kind, "done");
+  }
+  assert.notEqual(interpretReportStatusResponse({ ok: false, status: 500, data: { status: "done" } }).kind, "done", "a non-2xx never counts as done");
+});
+
+test("status: failed carries the backend's safe message, with a fallback", () => {
+  const r = interpretReportStatusResponse({ ok: true, status: 200, data: { status: "failed", error: "Report generation failed. Please try requesting the report again." } });
+  assert.equal(r.kind, "failed");
+  assert.match(r.message, /try requesting/);
+  assert.match(interpretReportStatusResponse({ ok: true, status: 200, data: { status: "failed", error: null } }).message, /try again/);
+});
+
+test("status: 404 'no report requested' is 'none'; other 404/401/5xx/network are distinguished", () => {
+  assert.equal(interpretReportStatusResponse({ ok: false, status: 404, data: { error: "not_found", message: "No report has been requested for this application yet." } }).kind, "none");
+  const appGone = interpretReportStatusResponse({ ok: false, status: 404, data: { error: "not_found", message: 'No application with id "x".' } });
+  assert.equal(appGone.kind, "error");
+  assert.equal(interpretReportStatusResponse({ ok: false, status: 401, data: {} }).kind, "unauthorized");
+  assert.equal(interpretReportStatusResponse({ ok: false, status: 500, data: { message: "Could not look up the application." } }).transient, true);
+  assert.equal(interpretReportStatusResponse({ ok: false, status: 0, data: { message: "Could not reach the server." } }).transient, true);
+  assert.equal(interpretReportStatusResponse({ ok: false, status: 403, data: {} }).transient, false);
+});
+
+test("request: 202 pending, 200 done, 400 needs_tailoring, 401, errors", () => {
+  assert.equal(interpretReportRequestResponse({ ok: true, status: 202, data: { status: "pending", reportId: "r" } }).kind, "pending");
+  assert.equal(interpretReportRequestResponse({ ok: true, status: 200, data: { status: "done", reportId: "r" } }).kind, "done");
+  const nt = interpretReportRequestResponse({ ok: false, status: 400, data: { error: "no_tailored_resume", message: "This application has no tailored resume yet. Tailor a resume first, then request a report." } });
+  assert.equal(nt.kind, "needs_tailoring");
+  assert.match(nt.message, /Tailor a resume first/);
+  assert.equal(interpretReportRequestResponse({ ok: false, status: 401, data: {} }).kind, "unauthorized");
+  assert.equal(interpretReportRequestResponse({ ok: false, status: 500, data: { message: "Could not request the report." } }).kind, "error");
+  assert.equal(interpretReportRequestResponse({ ok: true, status: 202, data: { status: "done" } }).kind, "error", "202 must say pending");
+});
+
+const noSleep = async () => {};
+
+test("poll: pending then done resolves done, one request at a time, with growing-then-capped delays", async () => {
+  const sleeps = [];
+  let inFlight = 0, maxInFlight = 0, calls = 0;
+  const fetchStatus = async () => {
+    inFlight++; maxInFlight = Math.max(maxInFlight, inFlight);
+    await new Promise((r) => setImmediate(r));
+    inFlight--; calls++;
+    return calls < 3 ? { kind: "pending" } : { kind: "done" };
+  };
+  const result = await pollReportStatus({ fetchStatus, sleep: async (ms) => { sleeps.push(ms); } });
+  assert.equal(result.kind, "done");
+  assert.equal(calls, 3);
+  assert.equal(maxInFlight, 1, "requests never overlap");
+  assert.deepEqual(sleeps, [1500, 2000, 3000]);
+});
+
+test("poll: never polls forever — stops at the attempt cap with 'timeout'", async () => {
+  let calls = 0;
+  const result = await pollReportStatus({ fetchStatus: async () => { calls++; return { kind: "pending" }; }, sleep: noSleep });
+  assert.equal(result.kind, "timeout");
+  assert.equal(calls, MAX_POLL_ATTEMPTS);
+});
+
+test("poll: delay is capped at the last configured value", async () => {
+  const sleeps = [];
+  await pollReportStatus({ fetchStatus: async () => ({ kind: "pending" }), sleep: async (ms) => sleeps.push(ms), maxAttempts: 8 });
+  assert.equal(Math.max(...sleeps), 5000);
+  assert.equal(sleeps.length, 8);
+});
+
+test("poll: failed and unauthorized stop immediately and pass through", async () => {
+  let calls = 0;
+  const failed = await pollReportStatus({ fetchStatus: async () => { calls++; return { kind: "failed", message: "boom" }; }, sleep: noSleep });
+  assert.deepEqual(failed, { kind: "failed", message: "boom" });
+  assert.equal(calls, 1);
+  assert.equal((await pollReportStatus({ fetchStatus: async () => ({ kind: "unauthorized" }), sleep: noSleep })).kind, "unauthorized");
+});
+
+test("poll: tolerates isolated transient errors, gives up after 3 in a row, resets on success", async () => {
+  const seq = [{ kind: "error", transient: true, message: "x" }, { kind: "pending" }, { kind: "error", transient: true, message: "x" }, { kind: "error", transient: true, message: "x" }, { kind: "done" }];
+  let i = 0;
+  assert.equal((await pollReportStatus({ fetchStatus: async () => seq[i++], sleep: noSleep })).kind, "done");
+
+  let n = 0;
+  const gaveUp = await pollReportStatus({ fetchStatus: async () => { n++; return { kind: "error", transient: true, message: "net down" }; }, sleep: noSleep });
+  assert.equal(gaveUp.kind, "error");
+  assert.equal(n, 3);
+
+  const hard = await pollReportStatus({ fetchStatus: async () => ({ kind: "error", transient: false, message: "forbidden" }), sleep: noSleep });
+  assert.equal(hard.kind, "error");
+});
+
+test("poll: cancellation (unmount) stops the loop before further requests", async () => {
+  let cancelled = false, calls = 0;
+  const result = await pollReportStatus({
+    fetchStatus: async () => { calls++; cancelled = true; return { kind: "pending" }; },
+    isCancelled: () => cancelled,
+    sleep: noSleep,
+  });
+  assert.equal(result.kind, "cancelled");
+  assert.equal(calls, 1);
+
+  let c2 = 0;
+  assert.equal((await pollReportStatus({ fetchStatus: async () => { c2++; return { kind: "pending" }; }, isCancelled: () => true, sleep: noSleep })).kind, "cancelled");
+  assert.equal(c2, 0);
+  assert.equal((await pollReportStatus({ fetchStatus: async () => ({ kind: "aborted" }), sleep: noSleep })).kind, "cancelled");
+});
+
+test("poll: 'none' after a request was accepted is surfaced as an error, not silently ignored", async () => {
+  const r = await pollReportStatus({ fetchStatus: async () => ({ kind: "none" }), sleep: noSleep });
+  assert.equal(r.kind, "error");
+});
+
+test("reportFilename: safe, readable, with fallback", () => {
+  assert.equal(reportFilename({ company: "Acme Inc.", role: "Backend Engineer" }), "acme-inc-backend-engineer-report.pdf");
+  assert.equal(reportFilename({ company: "../../etc", role: "" }), "etc-report.pdf");
+  assert.equal(reportFilename({}), "application-report.pdf");
+});
diff -ruN a/frontend/test/tailoring.test.js Job-Hunt-Command-Center-main/frontend/test/tailoring.test.js
--- a/frontend/test/tailoring.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/test/tailoring.test.js	2026-10-24 02:16:45.568365924 +0000
@@ -0,0 +1,84 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { parseBulletLines, validateBulletInput, normalizeGrounding, interpretTailorResponse, formatCostUsd, MAX_BULLETS, MAX_BULLET_LENGTH } from "../src/lib/tailoring.js";
+
+test("parseBulletLines: one per line, strips list markers, drops blanks, keeps '5+ years' intact", () => {
+  const text = "- Built APIs\n* Led a team\n\u2022 Shipped v2\n1. Fixed bugs\n2) Wrote docs\n\n   \n5+ years of Node.js\r\nPlain line";
+  assert.deepEqual(parseBulletLines(text), ["Built APIs", "Led a team", "Shipped v2", "Fixed bugs", "Wrote docs", "5+ years of Node.js", "Plain line"]);
+  assert.deepEqual(parseBulletLines(undefined), []);
+});
+
+test("validateBulletInput: mirrors the server limits (1-20 bullets, <=500 chars each)", () => {
+  assert.equal(validateBulletInput("").valid, false);
+  assert.equal(validateBulletInput("   \n  ").valid, false);
+  assert.deepEqual(validateBulletInput("Built X.").bullets, ["Built X."]);
+
+  const tooMany = Array.from({ length: MAX_BULLETS + 1 }, (_, i) => `b${i}`).join("\n");
+  assert.match(validateBulletInput(tooMany).errors[0], /at most 20/);
+
+  const atLimit = Array.from({ length: MAX_BULLETS }, (_, i) => `b${i}`).join("\n");
+  assert.equal(validateBulletInput(atLimit).valid, true);
+
+  const long = "x".repeat(MAX_BULLET_LENGTH + 1);
+  const r = validateBulletInput(`ok\n${long}`);
+  assert.equal(r.valid, false);
+  assert.match(r.errors[0], /Bullet 2 is 501 characters/);
+  assert.equal(validateBulletInput("x".repeat(MAX_BULLET_LENGTH)).valid, true);
+});
+
+const goodData = {
+  bullets: ["A.", "B."],
+  grounding: [
+    { index: 0, status: "accepted", issues: [] },
+    { index: 1, status: "reverted_to_original", issues: [{ type: "new_term", value: "Kubernetes", inJobDescription: true }, { type: "new_number", value: "40%", inJobDescription: false }], rejectedText: "B on Kubernetes by 40%." },
+  ],
+  usage: { model: "gpt-5.6-luna", promptTokens: 120, completionTokens: 40, costUsd: 0.000072 },
+};
+
+test("interpretTailorResponse: 201 success carries bullets, grounding and usage exactly as returned", () => {
+  const r = interpretTailorResponse({ ok: true, status: 201, data: goodData });
+  assert.equal(r.kind, "success");
+  assert.deepEqual(r.bullets, ["A.", "B."]);
+  assert.equal(r.grounding[1].status, "reverted_to_original");
+  assert.deepEqual(r.grounding[1].issues.map((i) => i.value), ["Kubernetes", "40%"]);
+  assert.equal(r.grounding[1].issues[0].inJobDescription, true);
+  assert.equal(r.grounding[1].rejectedText, "B on Kubernetes by 40%.");
+  assert.deepEqual(r.usage, { model: "gpt-5.6-luna", promptTokens: 120, completionTokens: 40, costUsd: 0.000072 });
+});
+
+test("interpretTailorResponse: missing/malformed grounding or usage becomes null — never invented", () => {
+  const noGrounding = interpretTailorResponse({ ok: true, status: 201, data: { bullets: ["A."] } });
+  assert.equal(noGrounding.kind, "success");
+  assert.equal(noGrounding.grounding, null);
+  assert.equal(noGrounding.usage, null);
+
+  assert.equal(normalizeGrounding([{ status: "weird" }], 1), null, "unknown status rejected");
+  assert.equal(normalizeGrounding([{ status: "accepted", issues: [] }], 2), null, "length mismatch rejected");
+  assert.equal(normalizeGrounding("nope", 1), null);
+
+  const partial = interpretTailorResponse({ ok: true, status: 201, data: { bullets: ["A."], usage: { model: "m", costUsd: "abc" } } });
+  assert.equal(partial.usage.costUsd, null);
+  assert.equal(partial.usage.promptTokens, null);
+});
+
+test("interpretTailorResponse: unexpected success shape is an error, not a blank result", () => {
+  for (const data of [{}, { bullets: [] }, { bullets: [1, 2] }, null]) {
+    assert.equal(interpretTailorResponse({ ok: true, status: 201, data }).kind, "error");
+  }
+});
+
+test("interpretTailorResponse: 401 -> unauthorized; abort -> aborted; 400 messages; 502 message; fallback", () => {
+  assert.equal(interpretTailorResponse({ ok: false, status: 401, data: { error: "unauthorized" } }).kind, "unauthorized");
+  assert.equal(interpretTailorResponse({ ok: false, status: 0, aborted: true, data: {} }).kind, "aborted");
+  assert.deepEqual(interpretTailorResponse({ ok: false, status: 400, data: { messages: ["baseBullets must contain at least one bullet"] } }).messages, ["baseBullets must contain at least one bullet"]);
+  assert.deepEqual(interpretTailorResponse({ ok: false, status: 502, data: { error: "llm_request_failed", message: "Could not reach the tailoring service." } }).messages, ["Could not reach the tailoring service."]);
+  const fallback = interpretTailorResponse({ ok: false, status: 500, data: { stack: "Error: secret internals at /srv/app.js" } });
+  assert.equal(fallback.kind, "error");
+  assert.ok(!JSON.stringify(fallback).includes("secret internals"), "raw error bodies are never surfaced");
+});
+
+test("formatCostUsd", () => {
+  assert.equal(formatCostUsd(0.000072), "$0.000072");
+  assert.equal(formatCostUsd(null), null);
+  assert.equal(formatCostUsd(NaN), null);
+});
