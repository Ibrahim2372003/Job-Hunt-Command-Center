diff -ruN -x node_modules a/backend/src/fit.js b/backend/src/fit.js
--- a/backend/src/fit.js	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/src/fit.js	2026-10-23 19:38:38.930779546 +0000
@@ -0,0 +1,114 @@
+import { tokenSet } from "./grounding.js";
+
+/**
+ * Transparent, deterministic requirement-vs-evidence matching.
+ *
+ * For each requirement we extract its meaningful words, then look at each
+ * piece of the user's own evidence (CV bullets / skills / projects) and see
+ * how many of those words it contains.
+ *
+ *   supported : some single evidence item contains >= 2/3 of the key words
+ *   partial   : some evidence contains at least one key word, but not enough
+ *   missing   : evidence exists but none of it mentions any key word
+ *   unclear   : we cannot judge — the user supplied no evidence at all, or
+ *               the requirement has no distinctive words to match on
+ *
+ * Deliberately NOT produced: a single numeric "fit score". Lexical overlap
+ * is a weak proxy for ability, and summing it into one number would imply a
+ * precision this method does not have. We return counts per status and the
+ * evidence behind every row instead.
+ *
+ * "missing" means "nothing in the CV text you provided mentions this" — it
+ * is NOT a claim that the user lacks the skill. If no evidence was provided
+ * at all, every row is "unclear", never "missing": absence of data is not
+ * absence of skill.
+ *
+ * LIMITATIONS: purely lexical — synonyms ("Postgres" vs "PostgreSQL"),
+ * paraphrases, and implied skills are not matched, so "missing" can be a
+ * false negative and "supported" does not prove depth. A semantic (LLM- or
+ * embedding-assisted) matcher is a natural next step but would need its own
+ * validation.
+ */
+
+const GENERIC_WORDS = new Set(
+  (
+    "a an and or the of to in on for with by at as is are be been being from into over under about " +
+    "this that these those our your their you we they it its who will can may must should have has had do does " +
+    "experience experienced years year strong solid proven demonstrated ability able knowledge understanding " +
+    "skills skill working work including plus such etc using use used familiarity familiar good excellent " +
+    "team teams environment environments role candidate candidates preferred required requirement requirements " +
+    "player degree related relevant similar proficiency proficient hands-on handson minimum least more than"
+  ).split(/\s+/)
+);
+
+export function keyTerms(requirementText) {
+  const words = String(requirementText).match(/[A-Za-z0-9][A-Za-z0-9+#._-]*/g) || [];
+  const out = [];
+  for (const w of words) {
+    const clean = w.replace(/[._-]+$/g, "");
+    const lower = clean.toLowerCase();
+    // Quantities ("5+", "10%") are not skills and a CV may spell them differently ("five years").
+    if (lower.length < 2 || GENERIC_WORDS.has(lower) || /^\d+[+%]?$/.test(lower)) continue;
+    if (!out.includes(lower)) out.push(lower);
+  }
+  return out;
+}
+
+function hits(terms, evidenceTokens) {
+  return terms.filter((t) => evidenceTokens.has(t) || (t.length > 3 && t.endsWith("s") && evidenceTokens.has(t.slice(0, -1))));
+}
+
+/**
+ * @param requirements  [{ text, importance?, ... }] — e.g. analysis.requirements
+ * @param evidenceItems [{ id, text }] — the user's own CV bullets/skills/projects
+ */
+export function assessFit(requirements, evidenceItems) {
+  const prepared = evidenceItems
+    .filter((e) => e && typeof e.text === "string" && e.text.trim())
+    .map((e) => ({ id: e.id, text: e.text, tokens: tokenSet(e.text) }));
+
+  const rows = requirements.map((req) => {
+    const terms = keyTerms(req.text);
+    const base = { requirement: req.text, importance: req.importance ?? "unspecified", keyTerms: terms };
+
+    if (prepared.length === 0) {
+      return { ...base, status: "unclear", matchedEvidence: [], explanation: "No CV or profile evidence was provided, so this cannot be assessed." };
+    }
+    if (terms.length === 0) {
+      return { ...base, status: "unclear", matchedEvidence: [], explanation: "This requirement has no distinctive terms to match against; review it manually." };
+    }
+
+    let best = { ratio: 0, matched: [], item: null };
+    const matchedEvidence = [];
+    for (const item of prepared) {
+      const matched = hits(terms, item.tokens);
+      if (matched.length > 0) matchedEvidence.push({ id: item.id, text: item.text, matchedTerms: matched });
+      const ratio = matched.length / terms.length;
+      if (ratio > best.ratio) best = { ratio, matched, item };
+    }
+    matchedEvidence.sort((a, b) => b.matchedTerms.length - a.matchedTerms.length);
+
+    if (best.ratio >= 2 / 3) {
+      return { ...base, status: "supported", matchedEvidence: matchedEvidence.slice(0, 3), explanation: `Matched ${best.matched.length} of ${terms.length} key terms in one piece of your evidence.` };
+    }
+    if (best.ratio > 0) {
+      const missingTerms = terms.filter((t) => !best.matched.includes(t));
+      return { ...base, status: "partial", matchedEvidence: matchedEvidence.slice(0, 3), explanation: `Evidence mentions ${best.matched.join(", ")} but nothing provided mentions ${missingTerms.join(", ")}.` };
+    }
+    return { ...base, status: "missing", matchedEvidence: [], explanation: "Nothing in the CV text you provided mentions these terms. This may reflect missing detail in the CV rather than a missing skill." };
+  });
+
+  const summary = { supported: 0, partial: 0, missing: 0, unclear: 0, total: rows.length };
+  for (const r of rows) summary[r.status] += 1;
+
+  return {
+    rows,
+    summary,
+    method: "lexical-overlap-v1",
+    limitations: [
+      "Matching is keyword-based; synonyms and paraphrases are not recognized, so 'missing' can be a false negative.",
+      "'Supported' means the terms appear together in your evidence, not that the depth of experience satisfies the role.",
+      "No overall score is computed on purpose; counts and per-requirement evidence are shown instead.",
+    ],
+  };
+}
diff -ruN -x node_modules a/backend/src/grounding.js b/backend/src/grounding.js
--- a/backend/src/grounding.js	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/src/grounding.js	2026-10-23 19:36:08.489005105 +0000
@@ -0,0 +1,142 @@
+/**
+ * Deterministic factual-consistency check for tailored CV bullets.
+ *
+ * Prompt instructions ("never invent experience") are not a correctness
+ * guarantee, so after the model responds we compare each tailored bullet
+ * against the user's ORIGINAL bullet at the same index and reject
+ * anything that introduces:
+ *
+ *   - a number / percentage / currency amount not in the original
+ *     ("new_number") — the classic fabricated-metric failure; or
+ *   - a tool / technology / proper-noun-like term not in the original
+ *     ("new_term"). If that term appears in the job description, the issue
+ *     is flagged `inJobDescription: true` — the signature of keyword
+ *     stuffing, where the model copies a requirement into the CV as if the
+ *     user had done it.
+ *
+ * A flagged bullet is REVERTED to the user's original text (never silently
+ * kept), and the report says why, so the UI can show it.
+ *
+ * LIMITATIONS (also documented in the README): this is lexical. It cannot
+ * detect semantic inflation ("contributed to" -> "led"), invented
+ * responsibilities phrased in plain lowercase words, or number words
+ * ("tripled"). It catches the highest-risk, most mechanical fabrications;
+ * it does not make the output provably true. The user must still review
+ * every bullet.
+ */
+
+const NUMBER_RE = /(?<![A-Za-z0-9.])\$?\d[\d,]*(?:\.\d+)?\s?(?:%|percent\b|[kKmMbB]\b)?/g;
+const TOKEN_RE = /[A-Za-z0-9][A-Za-z0-9+#._-]*/g;
+
+export function normalizeNumber(raw) {
+  return raw
+    .toLowerCase()
+    .replace(/[$,\s]/g, "")
+    .replace(/percent$/, "%");
+}
+
+export function extractNumbers(text) {
+  return new Set((String(text).match(NUMBER_RE) || []).map(normalizeNumber));
+}
+
+function cleanToken(t) {
+  return t.replace(/[._-]+$/g, "");
+}
+
+function variants(token) {
+  const key = token.toLowerCase();
+  const set = new Set([key]);
+  if (key.length > 3 && key.endsWith("s")) set.add(key.slice(0, -1));
+  if (key.length > 3 && key.endsWith("es")) set.add(key.slice(0, -2));
+  return set;
+}
+
+/** All word-ish tokens of a text, expanded with simple plural variants, as a lookup set. */
+export function tokenSet(text) {
+  const out = new Set();
+  for (const m of String(text).matchAll(TOKEN_RE)) {
+    for (const v of variants(cleanToken(m[0]))) out.add(v);
+  }
+  return out;
+}
+
+function isSentenceStart(text, index) {
+  const before = text.slice(0, index).trimEnd();
+  if (before === "") return true;
+  return /[.!?:;•\u2022\-–—\n]$/.test(before) || /\n\s*$/.test(text.slice(0, index));
+}
+
+/**
+ * Tokens that look like a named tool/technology/employer rather than an
+ * ordinary word: internal capitals (JavaScript, PostgreSQL, AWS), + or #
+ * (C++, C#), letter+digit mixes (S3, Python3), internal dots (Node.js),
+ * or a Capitalized word that is not at the start of a sentence.
+ */
+export function extractTerms(text) {
+  const src = String(text);
+  const terms = [];
+  for (const m of src.matchAll(TOKEN_RE)) {
+    const token = cleanToken(m[0]);
+    if (token.length < 2) continue;
+    if (/^\d+$/.test(token)) continue; // pure numbers handled separately
+    const internalCaps = /[A-Z]/.test(token.slice(1));
+    const symbolic = /[+#]/.test(token);
+    const mixedDigits = /[A-Za-z]/.test(token) && /\d/.test(token);
+    const internalDot = /[A-Za-z]\.[A-Za-z]/.test(token);
+    const capitalizedMidSentence = /^[A-Z][a-z]/.test(token) && !isSentenceStart(src, m.index);
+    if (internalCaps || symbolic || mixedDigits || internalDot || capitalizedMidSentence) {
+      terms.push(token);
+    }
+  }
+  return terms;
+}
+
+/**
+ * Compare one tailored bullet to its original.
+ * Returns the list of issues (empty = grounded as far as this check can tell).
+ */
+export function findGroundingIssues({ original, tailored, jobDescription = "" }) {
+  const issues = [];
+
+  const originalNumbers = extractNumbers(original);
+  for (const n of extractNumbers(tailored)) {
+    if (!originalNumbers.has(n)) issues.push({ type: "new_number", value: n, inJobDescription: extractNumbers(jobDescription).has(n) });
+  }
+
+  const originalTokens = tokenSet(original);
+  const jdTokens = tokenSet(jobDescription);
+  const seen = new Set();
+  for (const term of extractTerms(tailored)) {
+    const key = term.toLowerCase();
+    if (seen.has(key)) continue;
+    seen.add(key);
+    const known = [...variants(term)].some((v) => originalTokens.has(v));
+    if (!known) {
+      issues.push({ type: "new_term", value: term, inJobDescription: [...variants(term)].some((v) => jdTokens.has(v)) });
+    }
+  }
+  return issues;
+}
+
+/**
+ * Apply the check to a whole tailoring result. `baseBullets` and
+ * `tailoredBullets` must be the same length (llm.js enforces that first).
+ * Returns the corrected bullets plus a per-bullet report.
+ */
+export function enforceGrounding({ baseBullets, tailoredBullets, jobDescription = "" }) {
+  if (baseBullets.length !== tailoredBullets.length) {
+    throw new Error("enforceGrounding requires index-aligned bullet arrays.");
+  }
+  const reports = [];
+  const bullets = tailoredBullets.map((tailored, index) => {
+    const original = baseBullets[index];
+    const issues = findGroundingIssues({ original, tailored, jobDescription });
+    if (issues.length === 0) {
+      reports.push({ index, status: "accepted", issues: [] });
+      return tailored;
+    }
+    reports.push({ index, status: "reverted_to_original", issues, rejectedText: tailored });
+    return original;
+  });
+  return { bullets, reports };
+}
diff -ruN -x node_modules a/backend/src/jobAnalysis.js b/backend/src/jobAnalysis.js
--- a/backend/src/jobAnalysis.js	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/src/jobAnalysis.js	2026-10-23 19:36:48.863023131 +0000
@@ -0,0 +1,271 @@
+import { computeCostUsd, REQUEST_OPTIONS, DEFAULT_MODEL } from "./llm.js";
+import { fenceUntrusted, UNTRUSTED_DATA_NOTICE } from "./promptSafety.js";
+
+/**
+ * Structured job-description analysis.
+ *
+ * Contract (every field the model returns is re-validated here):
+ *
+ *   title / seniority / workArrangement / location:
+ *       null | { value, source: "stated"|"inferred", evidence, evidenceVerified }
+ *   requirements[]: { text, category, importance, source, evidence, evidenceVerified }
+ *   responsibilities[]: { text, evidence, evidenceVerified }
+ *   keywords[]: strings that literally occur in the job description
+ *   warnings[]: human-readable notes about anything corrected after the model responded
+ *
+ * "stated" is a CLAIM by the model that the job description says this
+ * explicitly. We do not take its word for it: a stated item must carry an
+ * `evidence` quote that is found verbatim (whitespace/case-insensitive) in
+ * the job description. If not, it is relabeled "inferred" and flagged.
+ * That is the deterministic line between "the posting says" and "the
+ * model thinks".
+ */
+
+export const CATEGORIES = ["skill", "experience", "education", "certification", "other"];
+export const IMPORTANCE = ["required", "preferred", "unspecified"];
+export const SOURCES = ["stated", "inferred"];
+
+const MAX_REQUIREMENTS = 40;
+const MAX_RESPONSIBILITIES = 25;
+const MAX_KEYWORDS = 30;
+const MAX_TEXT = 300;
+
+const nullableString = { type: ["string", "null"] };
+const sourcedValueSchema = {
+  type: "object",
+  properties: {
+    value: nullableString,
+    source: { type: "string", enum: SOURCES },
+    evidence: nullableString,
+  },
+  required: ["value", "source", "evidence"],
+  additionalProperties: false,
+};
+
+export const JOB_ANALYSIS_SCHEMA = {
+  type: "object",
+  properties: {
+    title: sourcedValueSchema,
+    seniority: sourcedValueSchema,
+    workArrangement: sourcedValueSchema,
+    location: sourcedValueSchema,
+    requirements: {
+      type: "array",
+      items: {
+        type: "object",
+        properties: {
+          text: { type: "string" },
+          category: { type: "string", enum: CATEGORIES },
+          importance: { type: "string", enum: IMPORTANCE },
+          source: { type: "string", enum: SOURCES },
+          evidence: nullableString,
+        },
+        required: ["text", "category", "importance", "source", "evidence"],
+        additionalProperties: false,
+      },
+    },
+    responsibilities: {
+      type: "array",
+      items: {
+        type: "object",
+        properties: { text: { type: "string" }, evidence: nullableString },
+        required: ["text", "evidence"],
+        additionalProperties: false,
+      },
+    },
+    keywords: { type: "array", items: { type: "string" } },
+  },
+  required: ["title", "seniority", "workArrangement", "location", "requirements", "responsibilities", "keywords"],
+  additionalProperties: false,
+};
+
+export class JobAnalysisOutputError extends Error {
+  constructor(message, { rawText, model, promptTokens, completionTokens, costUsd }) {
+    super(message);
+    this.name = "JobAnalysisOutputError";
+    this.rawText = rawText;
+    this.model = model;
+    this.promptTokens = promptTokens;
+    this.completionTokens = completionTokens;
+    this.costUsd = costUsd;
+  }
+}
+
+function normalizeForMatch(s) {
+  return String(s)
+    .toLowerCase()
+    .replace(/[\u2018\u2019]/g, "'")
+    .replace(/[\u201C\u201D]/g, '"')
+    .replace(/[*_`>#\u2022\u2023\u25E6\u2043\u2219•]+/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+/** True if `evidence` occurs verbatim (modulo case, whitespace, bullet glyphs) in `jobDescription`. */
+export function evidenceInText(evidence, jobDescription) {
+  if (typeof evidence !== "string") return false;
+  const e = normalizeForMatch(evidence);
+  if (e.length < 3) return false;
+  return normalizeForMatch(jobDescription).includes(e);
+}
+
+function escapeRegExp(s) {
+  return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+}
+
+function keywordInText(keyword, jobDescription) {
+  const k = normalizeForMatch(keyword);
+  if (k.length < 2) return false;
+  const re = new RegExp(`(^|[^a-z0-9])${escapeRegExp(k)}($|[^a-z0-9])`, "i");
+  return re.test(normalizeForMatch(jobDescription));
+}
+
+function asEnum(value, allowed, fallback) {
+  return allowed.includes(value) ? value : fallback;
+}
+
+function clip(text) {
+  return String(text).trim().slice(0, MAX_TEXT);
+}
+
+function applySourceCheck(source, evidence, jobDescription, counters) {
+  const claimedStated = source === "stated";
+  const verified = evidenceInText(evidence, jobDescription);
+  if (claimedStated && !verified) {
+    counters.downgraded += 1;
+    return { source: "inferred", evidence: null, evidenceVerified: false };
+  }
+  return {
+    source: claimedStated ? "stated" : "inferred",
+    evidence: verified ? clip(evidence) : null,
+    evidenceVerified: verified,
+  };
+}
+
+function normalizeSourcedValue(raw, jobDescription, counters) {
+  if (raw === null || raw === undefined) return null;
+  if (typeof raw !== "object" || Array.isArray(raw)) throw new Error("A sourced field was not an object.");
+  const value = typeof raw.value === "string" ? clip(raw.value) : "";
+  if (!value) return null;
+  return { value, ...applySourceCheck(raw.source, raw.evidence, jobDescription, counters) };
+}
+
+/**
+ * Pure: parse + validate + deterministically correct the model's raw JSON.
+ * Throws a plain Error for structurally unusable output; the caller wraps it
+ * with usage data. Never throws for "the model over-claimed 'stated'" — that
+ * is corrected and reported in `warnings` instead.
+ */
+export function parseJobAnalysis(rawText, jobDescription) {
+  let parsed;
+  try {
+    parsed = JSON.parse(rawText);
+  } catch {
+    throw new Error("Model output was not valid JSON.");
+  }
+  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+    throw new Error("Model output was not a JSON object.");
+  }
+  if (!Array.isArray(parsed.requirements)) throw new Error("Model output is missing a requirements array.");
+  if (!Array.isArray(parsed.responsibilities)) throw new Error("Model output is missing a responsibilities array.");
+  if (!Array.isArray(parsed.keywords)) throw new Error("Model output is missing a keywords array.");
+
+  const counters = { downgraded: 0, dropped: 0 };
+
+  const requirements = [];
+  for (const r of parsed.requirements.slice(0, MAX_REQUIREMENTS)) {
+    if (!r || typeof r !== "object" || typeof r.text !== "string" || !r.text.trim()) {
+      counters.dropped += 1;
+      continue;
+    }
+    requirements.push({
+      text: clip(r.text),
+      category: asEnum(r.category, CATEGORIES, "other"),
+      importance: asEnum(r.importance, IMPORTANCE, "unspecified"),
+      ...applySourceCheck(r.source, r.evidence, jobDescription, counters),
+    });
+  }
+  if (parsed.requirements.length > MAX_REQUIREMENTS) counters.dropped += parsed.requirements.length - MAX_REQUIREMENTS;
+
+  const responsibilities = [];
+  for (const r of parsed.responsibilities.slice(0, MAX_RESPONSIBILITIES)) {
+    if (!r || typeof r.text !== "string" || !r.text.trim()) {
+      counters.dropped += 1;
+      continue;
+    }
+    const verified = evidenceInText(r.evidence, jobDescription);
+    responsibilities.push({ text: clip(r.text), evidence: verified ? clip(r.evidence) : null, evidenceVerified: verified });
+  }
+
+  const keywords = [];
+  for (const k of parsed.keywords) {
+    if (typeof k !== "string") continue;
+    const kw = k.trim();
+    if (!kw || keywords.some((x) => x.toLowerCase() === kw.toLowerCase())) continue;
+    if (keywordInText(kw, jobDescription)) keywords.push(kw.slice(0, 60));
+    else counters.dropped += 1;
+    if (keywords.length >= MAX_KEYWORDS) break;
+  }
+
+  const warnings = [];
+  if (counters.downgraded > 0) {
+    warnings.push(`${counters.downgraded} item(s) were labeled "stated" by the model but no matching quote was found in the job description; they were relabeled "inferred".`);
+  }
+  if (counters.dropped > 0) {
+    warnings.push(`${counters.dropped} malformed, excess, or unsupported item(s) were removed from the model output.`);
+  }
+
+  return {
+    title: normalizeSourcedValue(parsed.title, jobDescription, counters),
+    seniority: normalizeSourcedValue(parsed.seniority, jobDescription, counters),
+    workArrangement: normalizeSourcedValue(parsed.workArrangement, jobDescription, counters),
+    location: normalizeSourcedValue(parsed.location, jobDescription, counters),
+    requirements,
+    responsibilities,
+    keywords,
+    warnings,
+  };
+}
+
+function buildPrompt(jobDescription) {
+  const instructions =
+    "You extract structured information from a job posting. " +
+    UNTRUSTED_DATA_NOTICE +
+    " Rules: (1) Mark an item source=\"stated\" ONLY if the posting says it explicitly, and then copy a short exact quote from the posting into `evidence`. " +
+    "(2) If you are interpreting, summarizing across sentences, or guessing, use source=\"inferred\" and evidence=null. " +
+    "(3) Do not infer seniority, location, or work arrangement unless stated; use value=null when not stated. " +
+    "(4) importance=\"required\" or \"preferred\" only when the wording supports it (e.g. 'must have', 'nice to have'); otherwise \"unspecified\". " +
+    "(5) `keywords` must be terms that literally appear in the posting. Return JSON matching the schema and nothing else.";
+  const input = `Job posting to analyze:\n${fenceUntrusted("job_description", jobDescription)}`;
+  return { instructions, input };
+}
+
+/**
+ * Calls the model, then validates/corrects. `openaiClient` is injected exactly
+ * like tailorBullets — tests pass a stub, so no network or key is needed.
+ */
+export async function analyzeJobDescription(openaiClient, { jobDescription, model = DEFAULT_MODEL }) {
+  const { instructions, input } = buildPrompt(jobDescription);
+
+  const response = await openaiClient.responses.create(
+    {
+      model,
+      instructions,
+      input,
+      text: { format: { type: "json_schema", name: "job_analysis", strict: true, schema: JOB_ANALYSIS_SCHEMA } },
+    },
+    REQUEST_OPTIONS
+  );
+
+  const promptTokens = response.usage?.input_tokens ?? 0;
+  const completionTokens = response.usage?.output_tokens ?? 0;
+  const costUsd = computeCostUsd(model, promptTokens, completionTokens);
+  const rawText = response.output_text ?? "";
+
+  try {
+    const analysis = parseJobAnalysis(rawText, jobDescription);
+    return { analysis, model, promptTokens, completionTokens, costUsd };
+  } catch (err) {
+    throw new JobAnalysisOutputError(err.message, { rawText, model, promptTokens, completionTokens, costUsd });
+  }
+}
